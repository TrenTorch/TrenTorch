# Fake, non-functional values -- exists only so svelte-check/build have
# something to bind $env/static/public to (see .env.example). CI never
# talks to a real Supabase project: nothing in lint/type-check/unit
# tests/build makes a network call, they just need these two names to
# resolve to *some* string. Never put a real project URL or key here.
PUBLIC_SUPABASE_URL="http://ci-does-not-hit-this.invalid"
PUBLIC_SUPABASE_ANON_KEY="ci-fake-anon-key-not-a-real-credential"
