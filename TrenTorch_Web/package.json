{
	"name": "trentorch-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --config .config/vite.config.ts",
		"build": "vite build --config .config/vite.config.ts",
		"preview": "vite preview --config .config/vite.config.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --ignore-path .gitignore --ignore-path .config/.prettierignore --check . && eslint --config .config/eslint.config.js .",
		"format": "prettier --ignore-path .gitignore --ignore-path .config/.prettierignore --write .",
		"test:unit": "vitest --config .config/vite.config.ts",
		"test": "npm run test:unit -- --run",
		"test:smoke": "vitest --config .config/vite.config.ts --run --project smoke",
		"test:pyodide": "vitest --config .config/vitest.pyodide.config.ts --run",
		"test:content": "python -m pytest data/app_data -q -n auto",
		"curriculum:build": "node processes/curriculum-build/build.mjs",
		"curriculum:check": "node processes/curriculum-build/build.mjs && prettier --write data/curriculum/generated-curriculum.json && git diff --exit-code -- data/curriculum"
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"trailingComma": "none",
		"printWidth": 100,
		"plugins": [
			"prettier-plugin-svelte",
			"prettier-plugin-tailwindcss"
		],
		"overrides": [
			{
				"files": "*.svelte",
				"options": {
					"parser": "svelte"
				}
			}
		],
		"tailwindStylesheet": "./platform/routes/layout.css"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^2.28.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/katex": "^0.16.8",
		"@types/node": "^26",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.1.1",
		"layerchart": "^2.5.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"pyodide": "0.27.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "^6.12.4",
		"@lezer/highlight": "^1.2.3",
		"@lucide/svelte": "^1.47.0",
		"@supabase/supabase-js": "^2.116.0",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"isomorphic-dompurify": "^4.3.0",
		"katex": "^0.18.7",
		"marked": "^18.0.13",
		"marked-katex-extension": "^5.1.12",
		"tailwind-merge": "^3.7.0"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
