# Supabase project for auth. Values are public-safe by design (the
# publishable/anon key is meant to ship in client bundles -- real access
# control lives in the database's row-level security policies), but each
# environment still needs its own .env with these two set to build.
PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_ANON_KEY=""

# Cloudflare Turnstile site key used by the magic-link sign-in widget.
PUBLIC_TURNSTILE_SITE_KEY=""

# Dedicated Turnstile widget for the "Report a bug" form.
PUBLIC_BUG_REPORT_TURNSTILE_SITE_KEY=""

# Corner ad widget. PUBLIC_AD_NETWORK is "ethical" (default, no approval
# needed), "carbon" (BuySellAds, invite-only, pays more), or "off".
PUBLIC_AD_NETWORK="ethical"
PUBLIC_ETHICALADS_PUBLISHER_ID=""
PUBLIC_CARBON_SERVE_ID=""
PUBLIC_CARBON_PLACEMENT=""
