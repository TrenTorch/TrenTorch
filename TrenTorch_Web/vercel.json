{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "npm ci",
	"buildCommand": "npm run build && cp build/404.html build/app.html",
	"outputDirectory": "build",
	"redirects": [
		{
			"source": "/questions",
			"destination": "/modules/aisys",
			"permanent": true
		},
		{
			"source": "/questions/part-research-papers",
			"destination": "/papers",
			"permanent": true
		},
		{
			"source": "/questions/:partId",
			"destination": "/modules/aisys?part=:partId",
			"permanent": true
		},
		{
			"source": "/cuda",
			"destination": "/modules/gpu",
			"permanent": true
		},
		{
			"source": "/cuda/theory",
			"destination": "/modules/gpu/theory",
			"permanent": true
		},
		{
			"source": "/cuda/problems",
			"destination": "/modules/gpu/problems",
			"permanent": true
		},
		{
			"source": "/cuda/glossary",
			"destination": "/modules/gpu/glossary",
			"permanent": true
		},
		{
			"source": "/cuda/spike",
			"destination": "/modules/gpu/spike",
			"permanent": true
		},
		{
			"source": "/cuda/theory/:chapter",
			"destination": "/modules/gpu/theory/:chapter",
			"permanent": true
		},
		{
			"source": "/dsa",
			"destination": "/modules/software",
			"permanent": true
		},
		{
			"source": "/dsa/theory/:step",
			"destination": "/modules/software/theory/:step",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/app.html"
		}
	]
}
