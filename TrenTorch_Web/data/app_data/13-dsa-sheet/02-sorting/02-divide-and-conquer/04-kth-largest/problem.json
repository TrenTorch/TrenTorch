{
  "schema": 1,
  "function": {
    "name": "kth_largest",
    "params": [
      {
        "name": "nums",
        "type": "list[int]"
      },
      {
        "name": "k",
        "type": "int"
      }
    ],
    "returns": "int"
  },
  "limits": {
    "timeMs": 2500
  },
  "hints": [
    "How is the `k`-th largest related to the position of a value in the sorted list?",
    "Do you need the whole list sorted? Try splitting the values around a pivot and see which side the answer is on.",
    "Split into smaller, equal and bigger. Keep only the part that contains the target position and repeat."
  ],
  "cases": [
    {"id": "example_1", "visible": true, "input": {"nums": [3, 2, 1, 5, 6, 4], "k": 2}, "expected": 5},
    {"id": "example_2", "visible": true, "input": {"nums": [5, 5, 3], "k": 3}, "expected": 3},
    {"id": "case_1", "input": {"nums": [7], "k": 1}, "expected": 7},
    {"id": "case_2", "input": {"nums": [1, 2], "k": 1}, "expected": 2},
    {"id": "case_3", "input": {"nums": [1, 2], "k": 2}, "expected": 1},
    {"id": "case_4", "input": {"nums": [4, 4, 4, 4], "k": 3}, "expected": 4},
    {"id": "case_5", "input": {"nums": [9, 1, 8, 2, 7, 3], "k": 4}, "expected": 3},
    {"id": "case_6", "input": {"nums": [-1, -5, 0, -3], "k": 2}, "expected": -1},
    {"id": "case_7", "input": {"nums": [1000000000, -1000000000, 0], "k": 3}, "expected": -1000000000},
    {"id": "case_8", "input": {"nums": [5, 4, 3, 2, 1], "k": 5}, "expected": 1},
    {"id": "case_9", "input": {"nums": [1, 2, 3, 4, 5], "k": 1}, "expected": 5},
    {"id": "perf_1", "perf": true, "input": {"nums": {"$gen": {"type": "int_array", "n": 1000000, "lo": -1000000000, "hi": 1000000000, "seed": 111}}, "k": 500000}, "expected": -72930606},
    {"id": "perf_2", "perf": true, "input": {"nums": {"$gen": {"type": "int_array", "n": 1000000, "lo": 0, "hi": 10, "seed": 112}}, "k": 1000}, "expected": 10},
    {"id": "perf_3", "perf": true, "input": {"nums": {"$gen": {"type": "permutation", "n": 1000000, "seed": 113}}, "k": 1}, "expected": 999999}
  ],
  "stress": {"runs": 200, "inputs": {"nums": {"type": "int_array", "n": {"min": 12, "max": 12}, "lo": -4, "hi": 4}, "k": {"type": "int", "lo": 1, "hi": 12}}}
}
