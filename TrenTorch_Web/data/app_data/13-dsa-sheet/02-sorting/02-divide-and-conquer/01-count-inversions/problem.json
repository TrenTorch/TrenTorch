{
  "schema": 1,
  "function": {
    "name": "count_inversions",
    "params": [
      {
        "name": "nums",
        "type": "list[int]"
      }
    ],
    "returns": "int"
  },
  "limits": {
    "timeMs": 3000
  },
  "hints": [
    "Count the inversions for `[3, 1, 2]` by hand. Which pairs are they?",
    "Sort the two halves first. Inversions across the halves are easy to count while merging them.",
    "When you take a value from the right half while the left half still has values waiting, each waiting left value is bigger. Add `len(left) - i`."
  ],
  "cases": [
    {"id": "example_1", "visible": true, "input": {"nums": [3, 1, 2]}, "expected": 2},
    {"id": "example_2", "visible": true, "input": {"nums": [1, 2, 3]}, "expected": 0},
    {"id": "case_1", "input": {"nums": []}, "expected": 0},
    {"id": "case_2", "input": {"nums": [5]}, "expected": 0},
    {"id": "case_3", "input": {"nums": [2, 1]}, "expected": 1},
    {"id": "case_4", "input": {"nums": [1, 1, 1]}, "expected": 0},
    {"id": "case_5", "input": {"nums": [2, 4, 1, 3, 5]}, "expected": 3},
    {"id": "case_6", "input": {"nums": [5, 4, 3, 2, 1]}, "expected": 10},
    {"id": "case_7", "input": {"nums": [1, 20, 6, 4, 5]}, "expected": 5},
    {"id": "case_8", "input": {"nums": [1000000000, -1000000000, 1000000000, -1000000000]}, "expected": 3},
    {"id": "perf_1", "perf": true, "input": {"nums": {"$gen": {"type": "int_array", "n": 7000, "lo": -1000000000, "hi": 1000000000, "seed": 106}}}, "expected": 12443019},
    {"id": "perf_2", "perf": true, "input": {"nums": {"$gen": {"type": "int_array", "n": 100000, "lo": -1000000000, "hi": 1000000000, "seed": 107}}}, "expected": 2500049920},
    {"id": "perf_3", "perf": true, "input": {"nums": {"$gen": {"type": "int_array", "n": 100000, "lo": 0, "hi": 5, "seed": 108}}}, "expected": 2086767704}
  ],
  "stress": {"runs": 200, "inputs": {"nums": {"type": "int_array", "n": {"min": 0, "max": 12}, "lo": -4, "hi": 4}}}
}
