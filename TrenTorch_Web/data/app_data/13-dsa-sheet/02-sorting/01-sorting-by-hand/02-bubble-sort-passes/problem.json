{
  "schema": 1,
  "function": {
    "name": "bubble_sort_passes",
    "params": [
      {
        "name": "nums",
        "type": "list[int]"
      }
    ],
    "returns": "int"
  },
  "limits": {
    "timeMs": 3000
  },
  "hints": [
    "Trace `[3, 2, 1]` by hand. How many passes make swaps? Add the final pass that finds nothing.",
    "Run the loop exactly as written and count. The limit is small enough to simulate.",
    "A value moves left only one place per pass. How is that related to how many bigger values come before it?"
  ],
  "cases": [
    {"id": "example_1", "visible": true, "input": {"nums": [3, 2, 1]}, "expected": 3},
    {"id": "example_2", "visible": true, "input": {"nums": [1, 2, 3]}, "expected": 1},
    {"id": "case_1", "input": {"nums": []}, "expected": 1},
    {"id": "case_2", "input": {"nums": [7]}, "expected": 1},
    {"id": "case_3", "input": {"nums": [2, 1]}, "expected": 2},
    {"id": "case_4", "input": {"nums": [1, 1, 1]}, "expected": 1},
    {"id": "case_5", "input": {"nums": [2, 3, 1]}, "expected": 3},
    {"id": "case_6", "input": {"nums": [1, 3, 2]}, "expected": 2},
    {"id": "case_7", "input": {"nums": [4, 3, 2, 1]}, "expected": 4},
    {"id": "case_8", "input": {"nums": [5, 1, 2, 3, 4]}, "expected": 2},
    {"id": "case_9", "input": {"nums": [2, 3, 4, 5, 1]}, "expected": 5},
    {"id": "case_10", "input": {"nums": [9, 8, 7, 6, 5, 4, 3, 2, 1]}, "expected": 9},
    {"id": "perf_1", "perf": true, "input": {"nums": {"$gen": {"type": "int_array", "n": 1500, "lo": -1000000, "hi": 1000000, "seed": 102}}}, "expected": 1374}
  ],
  "stress": {"runs": 200, "inputs": {"nums": {"type": "int_array", "n": {"min": 0, "max": 10}, "lo": -4, "hi": 4}}}
}
