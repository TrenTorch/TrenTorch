{
  "schema": 1,
  "function": {
    "name": "max_subarray_sum",
    "params": [
      {
        "name": "nums",
        "type": "list[int]"
      }
    ],
    "returns": "int"
  },
  "limits": {
    "timeMs": 1000
  },
  "hints": [
    "Look at one subarray ending at position `i`. How does its best sum relate to the best one ending at `i - 1`?",
    "At each element you either extend the previous run or start a new run at this element.",
    "`cur = max(x, cur + x)`, then `best = max(best, cur)`. Initialise both with the first element."
  ],
  "cases": [
    {"id": "example_1", "visible": true, "input": {"nums": [-2, 1, -3, 4, -1, 2, 1, -5, 4]}, "expected": 6},
    {"id": "example_2", "visible": true, "input": {"nums": [-3, -1, -2]}, "expected": -1},
    {"id": "case_1", "input": {"nums": [5]}, "expected": 5},
    {"id": "case_2", "input": {"nums": [-5]}, "expected": -5},
    {"id": "case_3", "input": {"nums": [1, 2, 3]}, "expected": 6},
    {"id": "case_4", "input": {"nums": [-1, -2, 3, -4]}, "expected": 3},
    {"id": "case_5", "input": {"nums": [2, -1, 2, -1, 2]}, "expected": 4},
    {"id": "case_6", "input": {"nums": [0, 0, 0]}, "expected": 0},
    {"id": "case_7", "input": {"nums": [-1, 0, -1]}, "expected": 0},
    {"id": "case_8", "input": {"nums": [10000, 10000, 10000, 10000, 10000, -10000, -10000, -10000, -10000, -10000]}, "expected": 50000},
    {"id": "perf_1", "perf": true, "input": {"nums": {"$gen": {"type": "int_array", "n": 5000, "lo": -1000, "hi": 1000, "seed": 4}}}, "expected": 23411},
    {"id": "perf_2", "perf": true, "input": {"nums": {"$gen": {"type": "int_array", "n": 200000, "lo": -10000, "hi": 10000, "seed": 5}}}, "expected": 4193467},
    {"id": "perf_3", "perf": true, "input": {"nums": {"$gen": {"type": "int_array", "n": 200000, "lo": -10000, "hi": -1, "seed": 6}}}, "expected": -1}
  ],
  "stress": {"runs": 200, "inputs": {"nums": {"type": "int_array", "n": {"min": 1, "max": 14}, "lo": -9, "hi": 9}}}
}
