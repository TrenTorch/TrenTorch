{
  "schema": 1,
  "function": {
    "name": "is_anagram",
    "params": [
      {
        "name": "a",
        "type": "str"
      },
      {
        "name": "b",
        "type": "str"
      }
    ],
    "returns": "bool"
  },
  "limits": {
    "timeMs": 1500
  },
  "hints": [
    "What property do two anagrams share, besides their letters?",
    "Count how many times each letter appears in each string.",
    "`from collections import Counter`, then compare `Counter(a)` and `Counter(b)`."
  ],
  "cases": [
    {"id": "example_1", "visible": true, "input": {"a": "listen", "b": "silent"}, "expected": true},
    {"id": "example_2", "visible": true, "input": {"a": "rat", "b": "car"}, "expected": false},
    {"id": "case_1", "input": {"a": "", "b": ""}, "expected": true},
    {"id": "case_2", "input": {"a": "a", "b": "a"}, "expected": true},
    {"id": "case_3", "input": {"a": "a", "b": "b"}, "expected": false},
    {"id": "case_4", "input": {"a": "ab", "b": "ba"}, "expected": true},
    {"id": "case_5", "input": {"a": "aab", "b": "abb"}, "expected": false},
    {"id": "case_6", "input": {"a": "abc", "b": "ab"}, "expected": false},
    {"id": "case_7", "input": {"a": "aabbcc", "b": "abcabc"}, "expected": true},
    {"id": "perf_1", "perf": true, "input": {"a": {"$gen": {"type": "string", "n": 1000000, "alphabet": "abcdefghijklmnopqrstuvwxyz", "seed": 16}}, "b": {"$gen": {"type": "string", "n": 1000000, "alphabet": "abcdefghijklmnopqrstuvwxyz", "seed": 17}}}, "expected": false},
    {"id": "perf_2", "perf": true, "input": {"a": {"$gen": {"type": "string", "n": 1000000, "alphabet": "abcdefghijklmnopqrstuvwxyz", "seed": 16}}, "b": {"$gen": {"type": "string", "n": 1000000, "alphabet": "abcdefghijklmnopqrstuvwxyz", "seed": 16}}}, "expected": true}
  ],
  "stress": {"runs": 200, "inputs": {"a": {"type": "string", "n": {"min": 0, "max": 6}, "alphabet": "abc"}, "b": {"type": "string", "n": {"min": 0, "max": 6}, "alphabet": "abc"}}}
}
