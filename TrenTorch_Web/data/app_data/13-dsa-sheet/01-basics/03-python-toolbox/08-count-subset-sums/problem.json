{
  "schema": 1,
  "function": {
    "name": "count_subset_sums",
    "params": [
      {
        "name": "nums",
        "type": "list[int]"
      },
      {
        "name": "k",
        "type": "int"
      },
      {
        "name": "target",
        "type": "int"
      }
    ],
    "returns": "int"
  },
  "limits": {
    "timeMs": 3000
  },
  "hints": [
    "How many ways are there to choose `k` positions out of `n`? Is that small enough to try them all?",
    "Is there a function that gives you all `k`-sized choices?",
    "`itertools.combinations(nums, k)`, and count those whose `sum` equals `target`."
  ],
  "cases": [
    {"id": "example_1", "visible": true, "input": {"nums": [1, 2, 3, 4], "k": 2, "target": 5}, "expected": 2},
    {"id": "example_2", "visible": true, "input": {"nums": [2, 2, 2], "k": 2, "target": 4}, "expected": 3},
    {"id": "case_1", "input": {"nums": [], "k": 0, "target": 0}, "expected": 1},
    {"id": "case_2", "input": {"nums": [], "k": 0, "target": 5}, "expected": 0},
    {"id": "case_3", "input": {"nums": [5], "k": 1, "target": 5}, "expected": 1},
    {"id": "case_4", "input": {"nums": [5], "k": 0, "target": 0}, "expected": 1},
    {"id": "case_5", "input": {"nums": [1, -1, 2, -2], "k": 2, "target": 0}, "expected": 2},
    {"id": "case_6", "input": {"nums": [1, 1, 1, 1], "k": 4, "target": 4}, "expected": 1},
    {"id": "case_7", "input": {"nums": [3, 4, 5], "k": 3, "target": 12}, "expected": 1},
    {"id": "case_8", "input": {"nums": [3, 4, 5], "k": 3, "target": 11}, "expected": 0},
    {"id": "perf_1", "perf": true, "input": {"nums": {"$gen": {"type": "int_array", "n": 22, "lo": -5, "hi": 20, "seed": 27}}, "k": 11, "target": 60}, "expected": 1255}
  ],
  "stress": {"runs": 200, "inputs": {"nums": {"type": "int_array", "n": {"min": 0, "max": 9}, "lo": -3, "hi": 6}, "k": {"type": "int", "lo": 0, "hi": 9}, "target": {"type": "int", "lo": -5, "hi": 12}}}
}
