From ddcbd9976a1eda3918700a2984fa7756f27e2ac9 Mon Sep 17 00:00:00 2001
From: claude <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 10:14:34 +0530
Subject: [PATCH 2/7] Export runtime globals via globalThis so Gpubox loads
 inside Web Workers

---
 demo/cuda-transpiler.js            | 5 +++--
 demo/desync-detector.js            | 5 +++--
 demo/fp16-bf16.js                  | 5 +++--
 demo/gpu-profiles.js               | 5 +++--
 demo/race-detector.js              | 5 +++--
 demo/sparse-memory.js              | 5 +++--
 demo/topology-model.js             | 5 +++--
 js/dist/runtime/cuda-transpiler.js | 5 +++--
 js/dist/runtime/desync-detector.js | 5 +++--
 js/dist/runtime/fp16-bf16.js       | 5 +++--
 js/dist/runtime/gpu-profiles.js    | 5 +++--
 js/dist/runtime/race-detector.js   | 5 +++--
 js/dist/runtime/sparse-memory.js   | 5 +++--
 js/dist/runtime/topology-model.js  | 5 +++--
 14 files changed, 42 insertions(+), 28 deletions(-)

diff --git a/demo/cuda-transpiler.js b/demo/cuda-transpiler.js
index 73b6870..5c010ab 100644
--- a/demo/cuda-transpiler.js
+++ b/demo/cuda-transpiler.js
@@ -2202,8 +2202,9 @@
   };
 
   // Export for browser
-  if (typeof window !== 'undefined') {
-    window.CudaTranspiler = CudaTranspiler;
+  // globalThis works on the main thread and inside Web Workers (no `window`)
+  if (typeof globalThis !== 'undefined') {
+    globalThis.CudaTranspiler = CudaTranspiler;
   }
 
   // Export for Node.js / CommonJS
diff --git a/demo/desync-detector.js b/demo/desync-detector.js
index 85cee99..1427f7c 100644
--- a/demo/desync-detector.js
+++ b/demo/desync-detector.js
@@ -252,8 +252,9 @@
   if (typeof module !== 'undefined' && module.exports) {
     module.exports = exported;
   }
-  if (typeof window !== 'undefined') {
-    window.GpuboxDesyncDetector = exported;
+  // globalThis works on the main thread and inside Web Workers (no `window`)
+  if (typeof globalThis !== 'undefined') {
+    globalThis.GpuboxDesyncDetector = exported;
   }
   if (typeof globalThis !== 'undefined') {
     globalThis.GpuboxDesyncDetector = exported;
