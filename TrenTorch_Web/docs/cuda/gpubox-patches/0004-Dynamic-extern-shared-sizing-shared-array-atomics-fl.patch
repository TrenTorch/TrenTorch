     counters.recordAtomic(ptr._allocId || 0, index);
+    if (ptr._f32 === undefined) return atomicOnArray(ptr, index, 'add', val);
     const absIdx = (ptr._offset !== undefined) ? ptr._offset + index : index;
     let old;
     if (ptr instanceof SharedMemory) {
@@ -1089,6 +1110,7 @@
 
